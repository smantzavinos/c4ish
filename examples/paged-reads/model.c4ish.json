{
	"$schema": "../../schema/model.schema.json",
	"schemaVersion": 0,
	"id": "paged-reads",
	"title": "Stock items: bounded paged reads",
	"summary": "Replace the all-items collector with independent, bounded, authorised reads and a sealed page cursor.",
	"profile": "../profile.c4ish.json",
	"provenance": { "baseline": "example", "note": "Invented example mirroring a real secure paged-reads change." },
	"views": [
		{
			"id": "engineering",
			"kind": "engineering",
			"title": "Stock items — bounded pages, not a bulk collector",
			"subtitle": "Each read authorises and meters itself; the page cursor is sealed; the old collector is retired with no fallback.",
			"focus": [
				"Rows render even when metadata fails: the loader awaits only the page read.",
				"The page cursor never exposes raw sort values; it is sealed with a deployment key that must be provisioned before rollout.",
				"Three new patterns are proposed (hatched); approve or redirect them."
			],
			"omitRelationships": ["summaryBudget", "metaBudget", "liveSummary"]
		}
	],
	"elements": [
		{ "id": "web", "kind": "container", "title": "Web app", "subtitle": "Stock pages", "change": "modified" },
		{
			"id": "loader",
			"kind": "component",
			"parent": "web",
			"title": "Page loader",
			"subtitle": "Awaits rows only; streams metadata seeds",
			"pattern": "web/ssr-live-page",
			"change": "modified",
			"libraries": ["httpClient"],
			"details": ["Seeds are bound to the viewer and the exact query arguments.", "Metadata seeds are started and caught independently."]
		},
		{
			"id": "owner",
			"kind": "component",
			"parent": "web",
			"title": "Current-page owner",
			"subtitle": "Current + at most one pending page",
			"pattern": "web/ssr-live-page",
			"change": "new",
			"libraries": ["liveClient"],
			"details": "Three automatic empty reads, then an explicit Continue; offscreen pages are never accumulated."
		},
		{
			"id": "history",
			"kind": "component",
			"parent": "web",
			"title": "Page-start history",
			"subtitle": "URL page + session start tokens only",
			"pattern": "web/sealed-page-history",
			"change": "new",
			"libraries": ["schemaLib"],
			"details": "Previous/Back read fresh. Unknown ancestry falls back to the first page instead of inventing a previous one."
		},
		{
			"id": "cards",
			"kind": "component",
			"parent": "web",
			"title": "Dashboard stock cards",
			"subtitle": "Own summary read; failure doesn't gate the page",
			"pattern": "web/ssr-live-page",
			"change": "modified"
		},
		{ "id": "api", "kind": "container", "title": "Backend", "subtitle": "Independent operations", "change": "modified" },
		{
			"id": "page",
			"kind": "component",
			"parent": "api",
			"title": "items.page",
			"subtitle": "ready(rows, next) | invalid-cursor | unavailable",
			"pattern": "api/scoped-read",
			"change": "new",
			"details": "Every request re-authorises; no identifier-bearing denial."
		},
		{
			"id": "summary",
			"kind": "component",
			"parent": "api",
			"title": "items.summary",
			"subtitle": "Complete scope counts; never partial",
			"pattern": "api/scoped-read",
			"change": "new"
		},
		{
			"id": "meta",
			"kind": "component",
			"parent": "api",
			"title": "Facets · totals · tags · options",
			"subtitle": "Four independent queries and budgets",
			"pattern": "api/tenant-query",
			"change": "new",
			"parts": [
				{ "title": "facets", "pattern": "api/scoped-read", "change": "new" },
				{ "title": "totals / tags / options", "pattern": "api/tenant-query", "change": "new" }
			]
		},
		{
			"id": "budget",
			"kind": "component",
			"parent": "api",
			"title": "Auth + metered read seam",
			"subtitle": "Each producer: auth + fresh budget",
			"pattern": "api/bounded-read",
			"change": "reused",
			"details": ["Runs before traversal or cursor opening.", "Hard overflow discards the whole operation."]
		},
		{
			"id": "merge",
			"kind": "component",
			"parent": "api",
			"title": "Index merge",
			"subtitle": "Sku / name / status / bin; one global cut",
			"pattern": "api/index-merge",
			"change": "new",
			"libraries": ["valueCompare"],
			"details": ["50 rows / 500 candidates are soft targets.", "Finishes tie buckets before cutting."]
		},
		{
			"id": "scope",
			"kind": "component",
			"parent": "api",
			"title": "Candidate scope filter",
			"subtitle": "Latest visible before filtering",
			"pattern": "api/bounded-read",
			"change": "new"
		},
		{
			"id": "seal",
			"kind": "component",
			"parent": "api",
			"title": "Sealed page cursor",
			"subtitle": "Deterministic authenticated encryption",
			"pattern": "api/sealed-continuation",
			"change": "new",
			"libraries": ["sivLib", "schemaLib"],
			"details": ["Binds actor, tenant and every normalised control.", "Missing key = unavailable; key rotation invalidates saved starts."]
		},
		{
			"id": "collector",
			"kind": "component",
			"parent": "api",
			"title": "items.getAll collector",
			"subtitle": "Deleted; no legacy fallback",
			"pattern": null,
			"change": "removed"
		},
		{ "id": "db", "kind": "container", "title": "Database", "subtitle": "No projection, no backfill", "change": "modified" },
		{
			"id": "items",
			"kind": "data",
			"parent": "db",
			"title": "stockItems",
			"subtitle": "Versioned rows",
			"pattern": "data/versioned-rows",
			"patterns": ["data/tenant-scoped"],
			"change": "modified",
			"fields": [
				{ "id": "tenantId", "type": "Id<tenants>", "change": "reused" },
				{ "id": "sku", "type": "string", "change": "reused" },
				{ "id": "version", "type": "number", "change": "reused" },
				{ "id": "name", "type": "string", "change": "reused" },
				{ "id": "status", "type": "draft | released", "change": "reused" }
			],
			"indexes": [
				{ "id": "by_tenant_name", "fields": ["tenantId", "name"], "change": "new" },
				{ "id": "by_tenant_status", "fields": ["tenantId", "status"], "change": "new" },
				{ "id": "by_tenant_sku_version", "fields": ["tenantId", "sku", "version"], "change": "reused" }
			]
		},
		{
			"id": "placements",
			"kind": "data",
			"parent": "db",
			"title": "binPlacements",
			"subtitle": "Where an item sits: shelf, bin or zone",
			"pattern": "data/polymorphic-ref",
			"change": "reused",
			"divergence": { "id": "DV-2", "text": "Discriminator and id unions are independent." },
			"fields": [
				{ "id": "level", "type": "shelf | bin | zone", "change": "reused" },
				{ "id": "targetId", "type": "Id<shelf|bin|zone>", "change": "reused" },
				{ "id": "itemId", "type": "Id<stockItems>", "change": "reused" }
			],
			"ties": [{ "fields": ["level", "targetId"], "label": "level ↔ targetId must agree", "enforcement": "nothing", "change": "reused", "divergence": "DV-2" }]
		},
		{
			"id": "tags",
			"kind": "data",
			"parent": "db",
			"title": "Tags + item tag joins",
			"subtitle": "Indexed per item",
			"pattern": "data/typed-join",
			"change": "reused"
		},
		{
			"id": "key",
			"kind": "secret",
			"title": "Cursor sealing key",
			"subtitle": "64-byte key per deployment",
			"pattern": "data/secret",
			"change": "new",
			"details": "Dev and test slots are provisioned; shared environments need a rollout step before deploy."
		},
		{ "id": "sivLib", "kind": "library", "title": "siv-aead", "version": "2.0", "change": "new" },
		{ "id": "schemaLib", "kind": "library", "title": "schema-validate", "change": "reused" },
		{ "id": "valueCompare", "kind": "library", "title": "value-compare", "change": "reused" },
		{ "id": "httpClient", "kind": "library", "title": "http client", "change": "reused" },
		{ "id": "liveClient", "kind": "library", "title": "live client", "change": "reused" }
	],
	"relationships": [
		{ "id": "seedPage", "from": "loader", "to": "page", "kind": "calls", "change": "new", "label": "await page only", "contract": "pageContract" },
		{ "id": "seedMeta", "from": "loader", "to": "meta", "kind": "calls", "change": "new", "label": "start + catch independently" },
		{ "id": "live", "from": "owner", "to": "page", "kind": "subscribes", "change": "new", "label": "immutable args", "contract": "pageContract" },
		{ "id": "remember", "from": "owner", "to": "history", "kind": "saves", "change": "new", "label": "no rows, no raw cuts" },
		{ "id": "cardRead", "from": "cards", "to": "summary", "kind": "subscribes", "change": "new", "label": "independent failure" },
		{ "id": "pageBudget", "from": "page", "to": "budget", "kind": "authorizes", "change": "new", "label": "own fresh budget" },
		{ "id": "summaryBudget", "from": "summary", "to": "budget", "kind": "authorizes", "change": "new" },
		{ "id": "metaBudget", "from": "meta", "to": "budget", "kind": "authorizes", "change": "new" },
		{ "id": "pageMerge", "from": "page", "to": "merge", "kind": "calls", "change": "new" },
		{ "id": "mergeIndexes", "from": "merge", "to": "items", "kind": "reads", "enforcement": "platform", "change": "new", "label": "native index order — not auth" },
		{ "id": "mergeScope", "from": "merge", "to": "scope", "kind": "filters", "change": "new", "label": "latest visible, then filters" },
		{ "id": "summaryScope", "from": "summary", "to": "scope", "kind": "calls", "change": "new" },
		{ "id": "scopeRefs", "from": "scope", "to": "placements", "kind": "reads", "enforcement": "our-code", "change": "new", "label": "check coherence + visibility" },
		{ "id": "placementTarget", "from": "placements", "to": "items", "kind": "references", "enforcement": "nothing", "change": "reused", "label": "type and id must agree", "divergence": "DV-2" },
		{ "id": "mergeTags", "from": "merge", "to": "tags", "kind": "reads", "enforcement": "platform", "change": "new", "label": "typed ids" },
		{ "id": "sealCut", "from": "merge", "to": "seal", "kind": "seals", "change": "new", "label": "one global cut", "contract": "cursorContract" },
		{ "id": "secret", "from": "seal", "to": "key", "kind": "reads", "enforcement": "our-code", "change": "new", "label": "fail closed" },
		{ "id": "retire", "from": "collector", "to": "page", "kind": "replaced-by", "change": "removed", "label": "retired; no fallback" },
		{ "id": "liveSummary", "from": "owner", "to": "summary", "kind": "subscribes", "change": "new" }
	],
	"contracts": [
		{
			"id": "pageContract",
			"title": "items.page",
			"change": "new",
			"clauses": {
				"args": "tenant + scope / search / types / status / tags / sort / direction / cursor",
				"returns": "ready {rows, next: null | string} | invalid-cursor | unavailable",
				"access": "authenticate + tenant + scope visibility before traversal",
				"limits": "soft 50 rows / 500 candidates; hard call, document and byte ceilings discard the whole operation"
			}
		},
		{
			"id": "cursorContract",
			"title": "sealed cursor",
			"change": "new",
			"clauses": {
				"encoding": "versioned prefix + base64url ciphertext of a fixed-size padded envelope",
				"binding": "actor + tenant + every normalised scope, filter and sort argument",
				"security": "no readable sort values; re-authorise before opening; no cursor table"
			}
		}
	],
	"notes": [
		{ "on": "budget", "kind": "note", "text": "The shared admission meter predates this change. Callers and ownership change, not the hard ceilings." },
		{ "on": "key", "kind": "risk", "title": "Rollout step needed", "text": "Shared environments must provision the sealing key before deploy, or every page read returns unavailable." },
		{ "on": "placementTarget", "kind": "risk", "title": "Existing divergence DV-2", "text": "Read coherence checks do not repair the schema: level and targetId can still disagree. Not fixed here." },
		{ "on": "summary", "kind": "question", "text": "Scope counts are complete counts, not exact version pins. Is that acceptable for dashboard cards?" }
	],
	"proposedPatterns": [
		{ "id": "web/sealed-page-history", "label": "sealed page history", "family": "web", "icon": "history", "colour": "#1e40af" },
		{ "id": "api/bounded-read", "label": "scope-first bounded read", "family": "api", "icon": "filter", "colour": "#0369a1" },
		{ "id": "api/index-merge", "label": "native index merge", "family": "api", "icon": "merge", "colour": "#a21caf" },
		{ "id": "api/sealed-continuation", "label": "sealed continuation", "family": "security", "icon": "seal", "colour": "#be185d" }
	]
}
